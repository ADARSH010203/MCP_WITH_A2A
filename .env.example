# Required
GROQ_API_KEY=your_groq_api_key_here

# Optional
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
MCP_URL=http://127.0.0.1:3000/sse
# Optional public base URL used in the Agent Card, e.g. https://agent.example.com
A2A_PUBLIC_URL=
CURRENCY_API_URL=https://api.frankfurter.dev/v2
CURRENCY_API_TIMEOUT_SECONDS=10
A2A_TASK_DB_PATH=.data/a2a_tasks.db
# Set to enable bearer authentication on the A2A endpoint.
A2A_API_KEY=
A2A_RATE_LIMIT_PER_MINUTE=60
A2A_MAX_CONCURRENT_TASKS=8
A2A_MAX_INPUT_CHARS=20000
A2A_MAX_COLLABORATIVE_AGENTS=3
A2A_TASK_RETENTION_DAYS=30

# Push notifications
# Production defaults: HTTPS required and private/loopback networks blocked.
PUSH_NOTIFICATION_REQUIRE_HTTPS=true
PUSH_NOTIFICATION_ALLOW_PRIVATE_NETWORKS=false
