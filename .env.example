# Required
GROQ_API_KEY=your_groq_api_key_here

# Optional
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Guarded semantic routing for requests that do not match a deterministic capability.
A2A_SEMANTIC_ROUTING_ENABLED=true
A2A_SEMANTIC_ROUTING_MIN_SCORE=0.58
A2A_SEMANTIC_ROUTING_SECONDARY_SCORE=0.72
A2A_SEMANTIC_ROUTING_MAX_AGENTS=3
# Optional global specialist allowlist; empty means all registered agents.
A2A_ALLOWED_AGENTS=
MCP_URL=http://127.0.0.1:3000/sse
# Optional public base URL used in the Agent Card, e.g. https://agent.example.com
A2A_PUBLIC_URL=
# Optional browser access. Comma-separated exact origins; empty keeps CORS disabled.
A2A_CORS_ORIGINS=
# Optional remote specialist services.
# Format: agent_type=http://host:port;agent_type=http://host:port
A2A_SPECIALIST_URLS=
# Optional per-specialist bearer credentials. Falls back to A2A_API_KEY when unset.
# Format: agent_type=key;agent_type=key
A2A_SPECIALIST_API_KEYS=
A2A_REMOTE_CONNECT_TIMEOUT_SECONDS=10
A2A_REMOTE_REQUEST_TIMEOUT_SECONDS=55
CURRENCY_API_URL=https://api.frankfurter.dev/v2
CURRENCY_API_TIMEOUT_SECONDS=10
A2A_TASK_DB_PATH=.data/a2a_tasks.db
# Set to enable bearer authentication on the A2A endpoint.
A2A_API_KEY=
A2A_RATE_LIMIT_PER_MINUTE=60
A2A_MAX_CONCURRENT_TASKS=8
A2A_MAX_INPUT_CHARS=20000
A2A_MAX_REQUEST_BODY_BYTES=1000000
A2A_MAX_TASK_ID_CHARS=128
A2A_MAX_SESSION_ID_CHARS=128
A2A_MAX_COLLABORATIVE_AGENTS=3
A2A_TASK_RETENTION_DAYS=30
A2A_MEMORY_DB_PATH=.data/a2a_memory.db
A2A_MEMORY_TURNS=8
A2A_MEMORY_MAX_CHARS=4000
# Strong secret used to derive opaque memory scope keys.
A2A_MEMORY_NAMESPACE_SECRET=
A2A_REMOTE_REQUIRE_HTTPS=true
A2A_REMOTE_REQUIRE_AUTH=true

A2A_MEMORY_RETENTION_DAYS=30
# Multi-agent reliability
A2A_SPECIALIST_TIMEOUT_SECONDS=45
A2A_SPECIALIST_MAX_RETRIES=1
A2A_SPECIALIST_RETRY_BACKOFF_SECONDS=0.25
A2A_MAX_AGENT_CALLS_PER_TASK=6

# Push notifications
# Production defaults: HTTPS required and private/loopback networks blocked.
PUSH_NOTIFICATION_REQUIRE_HTTPS=true
PUSH_NOTIFICATION_ALLOW_PRIVATE_NETWORKS=false
